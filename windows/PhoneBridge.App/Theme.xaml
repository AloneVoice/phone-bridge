<ResourceDictionary x:Class="PhoneBridge.App.Theme"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta wspólna z aplikacją Android: koral + atrament + piasek -->
    <Color x:Key="InkColor">#1C1B29</Color>
    <SolidColorBrush x:Key="PbInk" Color="#1C1B29" />
    <SolidColorBrush x:Key="PbInkRaised" Color="#2A2839" />
    <SolidColorBrush x:Key="PbInkLine" Color="#3D3A52" />
    <SolidColorBrush x:Key="PbSand" Color="#F7F3EE" />
    <SolidColorBrush x:Key="PbCard" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PbCoral" Color="#FF6A4D" />
    <SolidColorBrush x:Key="PbCoralHover" Color="#F25A3C" />
    <SolidColorBrush x:Key="PbCoralPressed" Color="#DE4C30" />
    <SolidColorBrush x:Key="PbCoralSoft" Color="#FFE6DF" />
    <SolidColorBrush x:Key="PbOnCoralSoft" Color="#8A2A16" />
    <SolidColorBrush x:Key="PbMuted" Color="#6E6A7C" />
    <SolidColorBrush x:Key="PbMutedOnDark" Color="#A9A4B8" />
    <SolidColorBrush x:Key="PbLine" Color="#E9E2DA" />
    <SolidColorBrush x:Key="PbSuccess" Color="#2FB37A" />
    <SolidColorBrush x:Key="PbError" Color="#C8402E" />
    <SolidColorBrush x:Key="PbErrorOnDark" Color="#FF8A75" />

    <FontFamily x:Key="PbFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="PbFontDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="PbIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Ikony (te same kształty co w aplikacji Android) -->
    <Geometry x:Key="PbGlyphLogo">M11,4.5 H15.5 A1,1 0 0 1 16.5,5.5 V14.5 A1,1 0 0 1 15.5,15.5 H11 A1,1 0 0 1 10,14.5 V5.5 A1,1 0 0 1 11,4.5 Z M3.5,10 H8 M6,7.8 L8,10 L6,12.2</Geometry>
    <Geometry x:Key="PbGlyphPhone">M8,2.75 H16 A2,2 0 0 1 18,4.75 V19.25 A2,2 0 0 1 16,21.25 H8 A2,2 0 0 1 6,19.25 V4.75 A2,2 0 0 1 8,2.75 Z M10.75,18.25 H13.25</Geometry>
    <Geometry x:Key="PbGlyphFolder">M3.5,7 A2,2 0 0 1 5.5,5 H9.1 L11.1,7.2 H18.5 A2,2 0 0 1 20.5,9.2 V17.5 A2,2 0 0 1 18.5,19.5 H5.5 A2,2 0 0 1 3.5,17.5 Z</Geometry>
    <Geometry x:Key="PbGlyphUp">M12,15.5 V4.5 M7.5,9 L12,4.5 L16.5,9 M5,19.5 H19</Geometry>
    <Geometry x:Key="PbGlyphDown">M12,4.5 V15.5 M7.5,11 L12,15.5 L16.5,11 M5,19.5 H19</Geometry>

    <Style x:Key="PbGlyph" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="StrokeThickness" Value="1.7" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>

    <!-- Typografia -->
    <Style x:Key="PbTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PbFontDisplay}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PbInk}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="PbMutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PbMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="PbLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PbMuted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="2,0,0,6" />
    </Style>

    <!-- Kafelek z ikoną -->
    <Style x:Key="PbTile" TargetType="Border">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{StaticResource PbCoralSoft}" />
    </Style>

    <!-- Karta -->
    <Style x:Key="PbCardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PbCard}" />
        <Setter Property="BorderBrush" Value="{StaticResource PbLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <!-- Przyciski -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PbCard}" />
        <Setter Property="BorderBrush" Value="{StaticResource PbLine}" />
        <Setter Property="Foreground" Value="{StaticResource PbInk}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#FBF8F4" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="#D9D0C6" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#F2ECE5" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource PbCoral}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PbPrimary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource PbCoral}" />
        <Setter Property="BorderBrush" Value="{StaticResource PbCoral}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource PbCoralHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource PbCoralPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Przycisk na ciemnym tle (okno postępu) -->
    <Style x:Key="PbGhostDark" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource PbSand}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource PbInkLine}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PbCaptionClose" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Foreground" Value="{StaticResource PbMutedOnDark}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent">
                        <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource PbIcons}" FontSize="10"
                                   Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource PbCoral}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pole wyboru -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource PbInk}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5"
                                BorderBrush="{StaticResource PbMuted}" Background="{StaticResource PbCard}" VerticalAlignment="Center">
                            <Path x:Name="Check" Data="M3.5,9 L7.5,12.5 L14.5,5.5" Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource PbCoral}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PbCoral}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PbCoral}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pasek postępu z animacją trybu nieokreślonego -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Background" Value="{StaticResource PbLine}" />
        <Setter Property="Foreground" Value="{StaticResource PbCoral}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid ClipToBounds="True">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                        <Border x:Name="PART_Track" />
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3" />
                        <Border x:Name="Runner" Width="90" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"
                                CornerRadius="3" Visibility="Collapsed">
                            <Border.RenderTransform>
                                <TranslateTransform X="-90" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Runner" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="RunnerAnimation">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Runner"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         From="-90" To="420" Duration="0:0:1.3">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="RunnerAnimation" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Okno: belka w kolorze atramentu z logo, treść na piaskowym tle -->
    <Style x:Key="PbWindow" TargetType="Window">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="Background" Value="{StaticResource PbSand}" />
        <Setter Property="FontFamily" Value="{StaticResource PbFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource PbInk}" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1"
                              CornerRadius="0" UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border Background="{TemplateBinding Background}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Height="44" Background="{StaticResource PbInk}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource PbCoral}">
                                        <Path Data="{StaticResource PbGlyphLogo}" Stroke="White" Style="{StaticResource PbGlyph}"
                                              StrokeThickness="1.5" Margin="3" />
                                    </Border>
                                    <TextBlock Text="PhoneBridge" Foreground="{StaticResource PbSand}" FontWeight="SemiBold"
                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{TemplateBinding Title}" Foreground="{StaticResource PbMutedOnDark}"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Style="{StaticResource PbCaptionClose}" HorizontalAlignment="Right"
                                        WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCloseClick" />
                            </Grid>
                            <AdornerDecorator>
                                <ContentPresenter />
                            </AdornerDecorator>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Okno postępu: ciemny „toast” w rogu ekranu -->
    <Style x:Key="PbToast" TargetType="Window">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="Background" Value="{StaticResource PbInk}" />
        <Setter Property="FontFamily" Value="{StaticResource PbFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource PbSand}" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1"
                              CornerRadius="0" UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
