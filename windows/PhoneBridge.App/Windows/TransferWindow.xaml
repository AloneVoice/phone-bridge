<Window x:Class="PhoneBridge.App.Windows.TransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource PbToast}"
        Title="PhoneBridge"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="Manual" Topmost="True" ShowInTaskbar="True" ShowActivated="False">
    <Grid Margin="16,16,12,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource PbCoral}" VerticalAlignment="Top">
            <Path x:Name="DirectionGlyph" Data="{StaticResource PbGlyphUp}" Stroke="White" Style="{StaticResource PbGlyph}" Margin="9" />
        </Border>

        <StackPanel Grid.Column="1" Margin="14,0,4,0">
            <TextBlock x:Name="Header" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="Summary" Foreground="{StaticResource PbMutedOnDark}" Margin="0,2,0,12" TextTrimming="CharacterEllipsis" />
            <ProgressBar x:Name="Progress" Maximum="1000" Background="{StaticResource PbInkLine}" />
            <DockPanel Margin="0,8,0,0">
                <TextBlock x:Name="Speed" DockPanel.Dock="Right" Foreground="{StaticResource PbMutedOnDark}" />
                <TextBlock x:Name="Status" TextWrapping="Wrap" />
            </DockPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="OpenFolderButton" Content="Otwórz folder" Style="{StaticResource PbGhostDark}" Margin="0,0,4,0"
                        Visibility="Collapsed" Click="OnOpenFolder" />
                <Button x:Name="ActionButton" Content="Anuluj" Style="{StaticResource PbGhostDark}" Click="OnAction" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
