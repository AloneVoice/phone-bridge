<Window x:Class="PhoneBridge.App.Windows.HotkeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource PbWindow}"
        Title="· skrót klawiaturowy"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" Topmost="True">
    <StackPanel Margin="24,22,24,24">
        <TextBlock Text="Naciśnij nową kombinację klawiszy" Style="{StaticResource PbTitle}" />
        <TextBlock Style="{StaticResource PbMutedText}" Margin="0,4,0,0"
                   Text="Skrót wysyła pliki zaznaczone w Eksploratorze. Np. Ctrl+Shift+S albo sam klawisz F8." />

        <Border Style="{StaticResource PbCardBorder}" Margin="0,18,0,0" Padding="16" MinHeight="88">
            <StackPanel x:Name="KeyTiles" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock x:Name="Message" Margin="2,10,0,0" TextWrapping="Wrap" Style="{StaticResource PbMutedText}" />

        <DockPanel Margin="0,22,0,0">
            <Button Content="Przywróć Ctrl+Alt+P" DockPanel.Dock="Left" Click="OnReset" Focusable="False" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Anuluj" Margin="0,0,10,0" Click="OnCancel" Focusable="False" />
                <Button x:Name="SaveButton" Content="Zapisz" Style="{StaticResource PbPrimary}" Click="OnSave" Focusable="False" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
